# GENESIS Environment Configuration

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-1.5-flash

# AI Gateway Resilience & Rate Limiting
AI_MAX_CONCURRENCY=2
AI_RPM=10
AI_CALL_TIMEOUT_MS=45000
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_MS=60000
AI_FORCE_RULES_MODE=false

# AI Result Cache
AI_CACHE_ENABLED=true
AI_CACHE_TTL_DAYS=30

# Background Job System
JOB_MAX_CONCURRENCY=1
JOBS_INLINE=false

# Phase 2 SRS Document Upload Limits
MAX_UPLOAD_SIZE_MB=15

# Phase 3 Source Code Submission & Static Analysis Limits
MAX_ZIP_SIZE_MB=50
MAX_EXTRACT_SIZE_MB=200
MAX_ZIP_ENTRIES=5000
MAX_FILE_SIZE_MB=10
MAX_SOURCE_FILES=2000
MAX_ANALYSIS_DEPTH=15
EXTRACTION_DIR=./data/extractions

# Storage Provider: 'local' (default) or 's3' / 'gcs' / 'r2' (for production object storage)
# Note: On serverless platforms (e.g. Vercel), local filesystem storage is ephemeral.
# Production deployments require configuring persistent cloud object storage (S3/GCS/R2).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage

# SQLite Database Path (Local Development)
# Note: For production serverless deployments, use a managed database (PostgreSQL/MySQL/Turso)
DATABASE_PATH=./data/genesis.sqlite

# Report Configuration
REPORT_VERSION=1.0.0
MAX_REPORT_EXCERPT_CHARS=500
